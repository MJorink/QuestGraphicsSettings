<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>disable</Nullable>
		<RootNamespace>QuestGraphicsSettings</RootNamespace>
		<LangVersion>default</LangVersion>
		<IsPackable>false</IsPackable>
		<AssemblyVersion>1.0.0.0</AssemblyVersion>
		<FileVersion>1.0.0.0</FileVersion>
		<NeutralLanguage>en-US</NeutralLanguage>
		<AssemblyName>QuestGraphicsSettings</AssemblyName>
		<LangVersion>latest</LangVersion>
		<ImplicitUsings>enable</ImplicitUsings>
	</PropertyGroup>

	<ItemGroup>
		<Reference Include="BoneLib">
		  <HintPath>$(HOME)/repos/BL-Libs/Mods/BoneLib.dll</HintPath>
		</Reference>
		<Reference Include="Assembly-CSharp">
		  <HintPath>$(HOME)/repos/BL-Libs/Quest/MelonLoader/Il2CppAssemblies/Assembly-CSharp.dll</HintPath>
		</Reference>
		<Reference Include="MelonLoader">
		  <HintPath>$(HOME)/repos/BL-Libs/Quest/MelonLoader/net8/MelonLoader.dll</HintPath>
		</Reference>
		<Reference Include="UnityEngine.CoreModule">
		  <HintPath>$(HOME)/repos/BL-Libs/Quest/MelonLoader/Il2CppAssemblies/UnityEngine.CoreModule.dll</HintPath>
		</Reference>
		<Reference Include="Unity.RenderPipelines.Universal.Runtime">
		  <HintPath>$(HOME)/repos/BL-Libs/Quest/MelonLoader/Il2CppAssemblies/Unity.RenderPipelines.Universal.Runtime.dll</HintPath>
		</Reference>
		<Reference Include="Unity.XR.Oculus">
		  <HintPath>$(HOME)/repos/BL-Libs/Quest/MelonLoader/Il2CppAssemblies/Unity.XR.Oculus.dll</HintPath>
		</Reference>
		<Reference Include="Il2Cppmscorlib">
		  <HintPath>$(HOME)/repos/BL-Libs/Quest/MelonLoader/Il2CppAssemblies/Il2Cppmscorlib.dll</HintPath>
		</Reference>
		<Reference Include="Il2CppInterop.Runtime">
		  <HintPath>$(HOME)/repos/BL-Libs/Quest/MelonLoader/net8/Il2CppInterop.Runtime.dll</HintPath>
		</Reference>
		<Reference Include="UnityEngine.UI">
		  <HintPath>$(HOME)/repos/BL-Libs/Quest/MelonLoader/Il2CppAssemblies/UnityEngine.UI.dll</HintPath>
		</Reference>
		<Reference Include="Unity.TextMeshPro">
		  <HintPath>$(HOME)/repos/BL-Libs/Quest/MelonLoader/Il2CppAssemblies/Unity.TextMeshPro.dll</HintPath>
		</Reference>
	</ItemGroup>

	<PropertyGroup>
		<AllowUnsafeBlocks>True</AllowUnsafeBlocks>
		<EnableDefaultCompileItems>false</EnableDefaultCompileItems>
	</PropertyGroup>

	<ItemGroup>
		<Compile Include="QuestGraphicsSettings.cs" />
	</ItemGroup>

	<Target Name="CopyOutput" AfterTargets="Build" Condition="'$(HOME)/repos/QuestGraphicsSettings/docs/Mods' != ''">
		<Copy SourceFiles="$(TargetPath)" DestinationFolder="$(HOME)/repos/QuestGraphicsSettings/docs/Mods" />
	</Target>
</Project>
